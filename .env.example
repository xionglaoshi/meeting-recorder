# meeting-server 配置样例
# 用法：复制成 .env 放在本目录（或 ~/.config/meeting-server/.env），按需填写。
# 也可直接用环境变量，环境变量优先级更高。
#
# 查找顺序：$MEETING_ENV_FILE → 本目录/.env → ~/.config/meeting-server/.env
#           → ~/.codex/.env → ~/.hermes/.env（历史遗留，仅兼容）

# ── 必需：语音识别与纪要生成 ──────────────────────────────
DASHSCOPE_API_KEY=            # 阿里百炼（录音转写、热词表）
DEEPSEEK_API_KEY=             # 纪要生成的 LLM

# ── 可选：腾讯会议记录导入 ───────────────────────────────
TENCENT_MEETING_TOKEN=

# ── 可选：目录覆盖 ──────────────────────────────────────
# MEETING_SERVER_HOME=/path/to/meeting-server
# MEETING_RECORDS_DIR=/path/to/meeting-server/records
# MEETING_PORT=8789

# ── 可选：知识库归档（不配则纪要只留在 records/，不同步外部库）──
# MEETING_KNOWLEDGE_BASE=/path/to/your/wiki
# MEETING_OBSIDIAN_INBOX=/path/to/your/inbox

# ── 可选：人事数据源（人名词表与实体核验用；不配则 person 层降级）──
# MEETING_HR_ETL=/path/to/hr_etl.py
# MEETING_HR_DB=/tmp/hr_data.db
# MEETING_HR_SRC_DIR=/path/to/员工档案材料
# MEETING_EMPLOYER_ENTITIES=/path/to/employer-entities.md

# ── 可选：腾讯会议 CLI 目录 ─────────────────────────────
# MEETING_TENCENT_CLI_DIR=/path/to/tencent-meeting-mcp/scripts

# ── 调试开关 ───────────────────────────────────────────
# MEETING_SKIP_MINUTES=1       # 只转写不生成纪要（省 token，调试用）
